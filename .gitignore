.env
.env.*
*.key
**/secrets*.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# ── Local data ───────────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

