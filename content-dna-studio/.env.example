# Copy to .env and fill in. Never commit .env.

# Required in production. Bills the account that owns the key.
ANTHROPIC_API_KEY=sk-ant-...

# Model for every analysis. claude-opus-5 is the default; claude-sonnet-5 is
# roughly 2.5x cheaper and fine for distribution packages.
CLAUDE_MODEL=claude-opus-5

# Set to 1 to run without an API key. Every analysis returns a deterministic
# placeholder document. Used by the test suite and for UI work.
CLAUDE_MOCK=0

# Set to "off" to disable the server-side refusal fallback (beta header
# server-side-fallback-2026-07-01). Leave on unless the API rejects it.
CLAUDE_FALLBACKS=on

# Random string, 32+ chars. Signs nothing today but reserved for cookies.
SESSION_SECRET=change-me

# Comma-separated emails that may change other users' plans via /api/admin.
ADMIN_EMAILS=

# Where the SQLite file lives. Directory is created on boot.
DATABASE_PATH=./data/content-dna.sqlite

PORT=3000
NODE_ENV=development
