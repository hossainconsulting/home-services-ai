{
  "name": "content-dna-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Turn any YouTube channel's transcripts into a content DNA report, hook swipe file, pillar map, 90-day calendar and omni-channel distribution packages.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node --no-warnings=ExperimentalWarning --import tsx --watch src/server.ts",
    "start": "node --no-warnings=ExperimentalWarning --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@hono/node-server": "^2.1.1",
    "dompurify": "^3.2.6",
    "hono": "^4.13.7",
    "marked": "^16.0.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
